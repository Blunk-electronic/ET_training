# Copy the netchangers on sheet 4:
schematic heater_driver show sheet 4


# Group the netchangers and some net segments:
schematic heater_driver define group 4 75 100 25 45



# schematic heater_driver delete group


# simple copy:
# schematic heater_driver copy group 0 40 0
# schematic heater_driver draw net Q 2 135 140 150 140
# schematic heater_driver draw net Q_N 2 115 102.5 115 100
# schematic heater_driver set cursor 110 120 10



# Copy the netchangers and some segments:
# multiple copy:
# auto center
schematic heater_driver copy group

# Paste the group on sheet 4:
# schematic heater_driver paste group 4 150 100

# Paste the group on sheet 3:
# schematic heater_driver paste group 3 140 123.75
# schematic heater_driver show sheet 3

# explicit center
# schematic heater_driver copy group 100 120
# schematic heater_driver paste group 2 160 120
# schematic heater_driver paste group 2 210 120
