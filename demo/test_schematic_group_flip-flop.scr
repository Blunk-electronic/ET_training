# Copy the flip-flop on sheet 2:
schematic heater_driver show sheet 2

# Group the gates only:
# schematic heater_driver define group 2 80 100 10 50

# Group the gates and some net segments:
schematic heater_driver define group 2 80 100 30 50



# schematic heater_driver delete group

# schematic heater_driver rotate unit IC1 D relative 90
# schematic heater_driver mirror unit IC1 D
# schematic heater_driver move name IC1 D relative 1 0



# simple copy:
# schematic heater_driver copy group 0 40 0
# schematic heater_driver draw net Q 2 135 140 150 140
# schematic heater_driver draw net Q_N 2 115 102.5 115 100
# schematic heater_driver set cursor 110 120 10



# Copy the flip-flop and some segments:
# multiple copy:
# auto center
schematic heater_driver copy group

# Paste the group on sheet 2:
schematic heater_driver paste group 2 140 123.75

# Paste the group on sheet 3:
schematic heater_driver paste group 3 140 123.75
# schematic heater_driver show sheet 3

# explicit center
# schematic heater_driver copy group 100 120
# schematic heater_driver paste group 2 160 120
# schematic heater_driver paste group 2 210 120
